### logout a user
POST {{AUTH_URL}}/logout
Content-Type: application/json

{
  "refreshToken": "{{REFRESH_TOKEN}}"
}

### refresh a user's token
POST {{AUTH_URL}}/refresh
Content-Type: application/json

{
  "refreshToken": "{{REFRESH_TOKEN}}"
}

#### === USERS ===
@USERS_URL = {{BASE_URL}}{{API_VERSION}}/users
@USER_URL = {{USERS_URL}}/me
@USER_ID = jr3bhkzdk1rt79ltb09z073c
### get a user's profile
GET {{USER_URL}}
Authorization: Bearer {{ACCESS_TOKEN}}

### Get a user by id
GET {{USERS_URL}}/{{USER_ID}}
Authorization: Bearer {{ACCESS_TOKEN}}

### Update user profile (username and/or avatar)
PATCH {{USER_URL}}
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "username": "newusername123",
  "avatar": 3
}

### Update only username
PATCH {{USER_URL}}
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "username": "cooluser456"
}

### Update only avatar (select avatar ID 1-10)
PATCH {{USER_URL}}
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "avatar": 7
}

### Delete a user (soft delete)
DELETE {{USER_URL}}
Authorization: Bearer {{ACCESS_TOKEN}}

