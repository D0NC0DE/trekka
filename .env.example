# Environment configuration for Trekka mobile app

# Base URL for Trekka API requests
# API_BASE_URL=YOUR_GOOGLE_MAPS_KEY(uses localhost, leave commented if running backend in localhost)

# Toggle to enable mock data sources
USE_MOCKS=false

# Flag to mark production mode; affects logging
IS_PRODUCTION=false

# Google Maps API key (used by analytics/logistics features)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
