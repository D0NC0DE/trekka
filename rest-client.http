@BASE_URL = http://localhost:3000/
@API_VERSION = /api/v1

#### === WELCOME ===
GET {{BASE_URL}}

#### === AUTHENTICATION ===
@AUTH_URL = {{BASE_URL}}{{API_VERSION}}/auth

### Authenticate a user with google
POST {{AUTH_URL}}/google

### create a new user
POST {{AUTH_URL}}/register

### login a user
POST {{AUTH_URL}}/login

### verify a user's otp
POST {{AUTH_URL}}/verify

### logout a user
POST {{AUTH_URL}}/logout

### refresh a user's token
POST {{AUTH_URL}}/refresh


#### === USERS ===
@USERS_URL = {{BASE_URL}}{{API_VERSION}}/users
@USER_URL = {{USERS_URL}}/me
@USER_ID = 1
### get a user's profile
GET {{USER_URL}}

### Get a user by id
GET {{USERS_URL}}/{{USER_ID}}

### Update a user
PUT {{USER_URL}}

### Delete a user
DELETE {{USER_URL}}

#TODO: Add endpoints for users that want to be providers of services


#### === WALLETS ===
@WALLETS_URL = {{BASE_URL}}{{API_VERSION}}/wallets
@WALLET_URL = {{WALLETS_URL}}/me
@EXPORT_URL = {{WALLET_URL}}/export

### Get a user's wallet Information
GET {{WALLET_URL}}

### Get wallet balance
GET {{WALLET_URL}}/balance

### Get wallet address
GET {{WALLET_URL}}/address

### Withdraw from wallet
POST {{WALLET_URL}}/withdraw

### Verify a withdrawal
POST {{WALLET_URL}}/withdraw/verify

### Export a user's wallet
POST {{EXPORT_URL}}/request

### Verify export is from the correct user
POST {{EXPORT_URL}}/verify

