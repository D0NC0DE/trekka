model Ride {
    id                 String                  @id @default(cuid(2))
    riderId            String
    rider              User                    @relation("RiderRides", fields: [riderId], references: [id], onDelete: Cascade)
    driverId           String?
    driver             User?                   @relation("DriverRides", fields: [driverId], references: [id], onDelete: SetNull)
    status             RideStatus              @default(REQUESTED)
    canceledBy         RideCancellationSource?
    reachedDestination Boolean                 @default(false)
    price              Decimal                 @db.Decimal(10, 2)
    createdAt          DateTime                @default(now())
    updatedAt          DateTime                @updatedAt

    @@map("rides")
}

enum RideStatus {
    REQUESTED
    ACCEPTED
    ARRIVED
    IN_PROGRESS
    COMPLETED
    CANCELED
}

enum RideCancellationSource {
    RIDER
    DRIVER
}
